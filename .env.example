# Live source. If SCREECH_VIDEO_SOURCE is empty, SCREECH_VIDEO_ID is resolved with yt-dlp.
SCREECH_VIDEO_ID=HRhToy9dA-Q
SCREECH_VIDEO_SOURCE=

# Detector
SCREECH_MODEL=yolo26n.pt
SCREECH_DETECTOR_CONFIDENCE=0.08
SCREECH_MIN_BOX_AREA_RATIO=0.005
SCREECH_IDENTITY_MODE=size
SCREECH_FEMALE_AREA_RATIO=0.08
SCREECH_IDENTITY_DEADBAND=0.01
SCREECH_MOVEMENT_STDDEV_RATIO=0.012

# State smoothing / cadence
SCREECH_SCAN_INTERVAL_SECONDS=5
SCREECH_STREAM_RETRY_SECONDS=10
SCREECH_EMPTY_CONFIRMATIONS=8
SCREECH_STATE_CONFIRMATIONS=3
SCREECH_BEHAVIOR_HISTORY=6

# Storage
# SCREECH_DATA_DIR=C:\path\to\screech-data
# SCREECH_DB_PATH=C:\path\to\screech-data\hawk_data.db
SCREECH_SAVE_SNAPSHOTS=true
SCREECH_SAVE_CROPS=true
SCREECH_OBSERVATION_INTERVAL_SECONDS=60

# Weather
SCREECH_WEATHER_LATITUDE=38.8681
SCREECH_WEATHER_LONGITUDE=-77.2183
SCREECH_WEATHER_TTL_SECONDS=600
SCREECH_FACT_TTL_SECONDS=60

# Local clip testing
SCREECH_LOOP_LOCAL_SOURCE=true

# Usually leave blank because the frontend is served by the same FastAPI app.
# Example if you later separate the frontend:
# SCREECH_ALLOWED_ORIGINS=http://localhost:5173
SCREECH_ALLOWED_ORIGINS=
